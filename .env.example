# Required
ANTHROPIC_API_KEY=sk-ant-...

# Signs the session cookie. `npm run seed` generates one into .env if missing.
# Rotating it logs everyone out.
SESSION_SECRET=

# Model routing. Defaults below were current in August 2026; ids and prices drift,
# so run `npm run models` to see what your key can actually call and check
# https://platform.claude.com/docs/en/about-claude/pricing before committing.
#
#   guide      — writes the Pocket Guide / Exam Review. The quality lever: everything
#                downstream is derived from it. Worth the strongest tier.
#   planner    — decides the thematic blocks. Leave it empty: it falls back to the
#                guide model, and the prompt cache is per-model, so a different
#                planner model forces a second cache write of the whole extract —
#                which costs more than the cheaper tier saves.
#   derivative — quiz questions (needs judgement for plausible distractors).
#   cheap      — flashcards and cheat sheet (mechanical transformation).
ESTUDO_MODEL_GUIDE=claude-opus-5
# ESTUDO_MODEL_PLANNER=      # empty = same as ESTUDO_MODEL_GUIDE
ESTUDO_MODEL_DERIVATIVE=claude-sonnet-5
ESTUDO_MODEL_CHEAP=claude-haiku-4-5-20251001

# Optional
ESTUDO_DATA_DIR=./data
ESTUDO_MAX_OUTPUT_TOKENS=16000
